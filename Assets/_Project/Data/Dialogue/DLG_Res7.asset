  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Res7
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: First week on station. I keep getting lost on the mezzanine.
    choices:
    - text: How are you finding it?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: The view is unreal. The food is... real. Too real. Do you know where the canteen is? Nobody does.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: See you, I guess. If I can find you.
    choices: []
