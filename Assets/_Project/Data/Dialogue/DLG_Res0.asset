  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Res0
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Don't mind the pipes. Half of them hum in B-flat.
    choices:
    - text: What do you work on?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Life support. Air, water, pressure. If it ever smells like pennies in here, come find me. Fast.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Breathe easy.
    choices: []
