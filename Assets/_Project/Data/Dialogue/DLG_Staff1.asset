  startNode: start
  nodes:
  - id: start
    line: Noodles, broth, the spicy one if you're brave.
    choices:
    - text: Let's trade.
      next: '@trade'
    - text: What's good?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: The hydro greens came in fresh this cycle. Order the green broth before the night shift eats it all.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Come back hungry.
    choices: []
