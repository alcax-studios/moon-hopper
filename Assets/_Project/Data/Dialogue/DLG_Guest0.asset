  m_Name: DLG_Guest0
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Layover. Fourteen hours. I've counted every tile.
    choices:
    - text: Where are you headed?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: The ring, then home. Assuming the shuttle doesn't get bumped again.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Safe travels.
    choices: []
