  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Res6
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Shift change in twenty. Then coffee. Then sleep. In that order.
    choices:
    - text: Busy shift?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Two shuttles, a pressure alarm, and somebody left a wrench in a vent. So, a normal Thursday.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Don't wake me.
    choices: []
