  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Staff3
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Coffee's the only thing on this station that's never late.
    choices:
    - text: Busy today?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Shift change in an hour. Then it's a line out the door and somebody always cries about oat milk.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Stay caffeinated.
    choices: []
