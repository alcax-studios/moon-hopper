  startNode: start
  nodes:
  - id: start
    line: Did you hear the range earlier? Somebody's having fun.
    choices:
    - text: Does it bother you?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Only when the walls shake. Which is always. You get used to it.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Stay safe.
    choices: []
