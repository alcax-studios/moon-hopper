  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Res4
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Careful by the planters. I just turned that soil.
    choices:
    - text: What grows best here?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Anything stubborn. The yuccas love it. The ferns sulk unless I talk to them.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Say hi to the ferns.
    choices: []
