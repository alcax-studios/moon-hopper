  m_Name: DLG_Patron2
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Break time. Ten whole minutes.
    choices:
    - text: Busy day?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Hydroponics had a pump fail. I've been elbow deep in nutrient slurry since dawn.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Back to the slurry.
    choices: []
