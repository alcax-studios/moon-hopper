%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Guard
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Station Security. Everything alright?
    choices:
    - text: What does security do around here?
      next: job
    - text: Seen any trouble lately?
      next: trouble
    - text: Where can I find weapons?
      next: armory
    - text: Just passing through.
      next: bye
  - id: job
    line: Keep the peace, check the pads, walk the halls. Mostly we stop people doing something stupid outside the range.
    choices:
    - text: Ask something else.
      next: start
    - text: Thanks.
      next: bye
  - id: trouble
    line: Insurgent cells have been probing the outer locks. If shooting starts, get behind something solid and let us work.
    choices:
    - text: Ask something else.
      next: start
    - text: I can handle myself.
      next: handle
  - id: handle
    line: Then handle yourself on our side of the line. Shoot one of us and you're the problem.
    choices:
    - text: Understood.
      next: start
    - text: See you.
      next: bye
  - id: armory
    line: East hall, the door across from the range. The quartermaster signs everything out. Live fire on the range only.
    choices:
    - text: Ask something else.
      next: start
    - text: Thanks.
      next: bye
  - id: bye
    line: Stay safe out there.
    choices: []
