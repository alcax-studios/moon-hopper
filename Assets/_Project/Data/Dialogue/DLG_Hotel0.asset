  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Hotel0
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Welcome to the Airport Hotel. Your room is 1202, up the elevator.
    choices:
    - text: Anything I should know?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Checkout is whenever your shuttle leaves. The view from the twelfth floor is worth the trip down from orbit.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Enjoy your stay.
    choices: []
