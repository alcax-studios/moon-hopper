  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Res1
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: The palms are a morale experiment, believe it or not.
    choices:
    - text: Is it working?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Productivity's up four percent since we planted them. Or that's the new coffee. Hard to isolate variables on a moon.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Mind the soil. It's imported, every grain.
    choices: []
