  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Res5
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: The info desk screen glitched again. Third time today.
    choices:
    - text: Is that normal?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Nothing on this station is normal. But the glitches line up with the lab doors cycling. I'm writing it down.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: If the lights flicker, it wasn't me.
    choices: []
