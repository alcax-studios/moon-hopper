  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Res3
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Keep it civil in the atrium. The range is through the east door if you need to blow off steam.
    choices:
    - text: What's going on with the labs?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Locked down since Tuesday. Don't ask me why. I genuinely don't know why, and nobody's telling me.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Stay out of trouble.
    choices: []
