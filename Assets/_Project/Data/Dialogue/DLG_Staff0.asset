  m_Script: {fileID: 11500000, guid: 705b193c12cddfb48bd3281455bd9c63, type: 3}
  m_Name: DLG_Staff0
  m_EditorClassIdentifier: Assembly-CSharp::Alcax.Dialogue.DialogueTree
  startNode: start
  nodes:
  - id: start
    line: Armory. Everything on the wall is signed out to you the moment you lift it.
    choices:
    - text: Let's trade.
      next: '@trade'
    - text: Any rules?
      next: topic
    - text: See you around.
      next: bye
  - id: topic
    line: Live fire on the range only. Fire anywhere else and security will be on you before the brass stops rolling.
    choices:
    - text: Ask something else.
      next: start
    - text: Take care.
      next: bye
  - id: bye
    line: Bring them back clean.
    choices: []
